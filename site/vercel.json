{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/download", "destination": "https://github.com/jindratilk/fokly/releases/latest/download/Fokly.dmg", "permanent": false },
    { "source": "/github", "destination": "https://github.com/jindratilk/fokly", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/appcast.xml", "headers": [
      { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=300" }
    ] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
